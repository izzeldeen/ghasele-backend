        // sign-in this is the app's bundle identifier. For an Android/web flow add
        // the Services ID here too. Must track the iOS bundle id exactly - a
        // mismatch surfaces in the app as "IDX10214: Audience validation failed".
        "ClientIds": [ "com.kalbouneh.cleanyjo" ]
    },
    // Guards for the destructive, unauthenticated purge endpoint in
    // MaintenanceController. Keep PurgeEnabled false except while running a
    // purge, and set PurgeToken to a long random value before enabling.
